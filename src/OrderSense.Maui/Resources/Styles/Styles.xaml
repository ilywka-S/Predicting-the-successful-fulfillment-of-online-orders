<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource RingLight}, Dark={StaticResource RingDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource MutedForegroundLight}, Dark={StaticResource MutedForegroundDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource MutedForegroundLight}, Dark={StaticResource MutedForegroundDark}}" />
        <Setter Property="FlyoutBackgroundColor" Value="{AppThemeBinding Light={StaticResource SidebarLight}, Dark={StaticResource SidebarDark}}" />
        <Setter Property="FlyoutWidth" Value="{StaticResource SidebarWidth}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
    </Style>

    <Style x:Key="PageStack" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="{OnIdiom Phone='16', Default='32,24,32,32'}" />
        <Setter Property="Spacing" Value="{OnIdiom Phone=16, Default=24}" />
        <Setter Property="MaximumWidthRequest" Value="{StaticResource ContentMaxWidth}" />
    </Style>

    <Style x:Key="Backdrop" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <Style x:Key="BackdropMuted" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource TextSm}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="TextH1" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource Text2Xl}" />
    </Style>

    <Style x:Key="TextH2" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource TextLg}" />
    </Style>

    <Style x:Key="TextH3" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource TextBase}" />
    </Style>

    <Style x:Key="TextDisplay" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="{StaticResource Text4Xl}" />
    </Style>

    <Style x:Key="TextStat" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource Text2Xl}" />
    </Style>

    <Style x:Key="TextMedium" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
    </Style>

    <Style x:Key="TextSemiBold" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
    </Style>

    <Style x:Key="TextMuted" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedForegroundLight}, Dark={StaticResource MutedForegroundDark}}" />
    </Style>

    <Style x:Key="TextSmall" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TextXs}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedForegroundLight}, Dark={StaticResource MutedForegroundDark}}" />
    </Style>

    <Style x:Key="TextLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
    </Style>

    <Style x:Key="TextError" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskHighTextLight}, Dark={StaticResource RiskHighTextDark}}" />
    </Style>

    <Style x:Key="TextTableHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedForegroundLight}, Dark={StaticResource MutedForegroundDark}}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconMuted" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedForegroundLight}, Dark={StaticResource MutedForegroundDark}}" />
    </Style>

    <Style x:Key="IconError" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskHighTextLight}, Dark={StaticResource RiskHighTextDark}}" />
    </Style>

    <Style x:Key="IconRiskUp" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskHighTextLight}, Dark={StaticResource RiskHighTextDark}}" />
    </Style>

    <Style x:Key="IconRiskDown" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskLowTextLight}, Dark={StaticResource RiskLowTextDark}}" />
    </Style>

    <Style x:Key="SpinnerOnPrimary" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryForegroundLight}, Dark={StaticResource PrimaryForegroundDark}}" />
        <Setter Property="WidthRequest" Value="16" />
        <Setter Property="HeightRequest" Value="16" />
        <Setter Property="InputTransparent" Value="True" />
    </Style>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource TextSm}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=44, Default=36}" />
        <Setter Property="MinimumWidthRequest" Value="{OnIdiom Phone=44, Default=36}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryForegroundLight}, Dark={StaticResource PrimaryForegroundDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryHoverLight}, Dark={StaticResource PrimaryHoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryHoverLight}, Dark={StaticResource PrimaryHoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryForegroundLight}, Dark={StaticResource SecondaryForegroundDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryHoverLight}, Dark={StaticResource SecondaryHoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryHoverLight}, Dark={StaticResource SecondaryHoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonOutline" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource InputLight}, Dark={StaticResource InputDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonGhost" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonDestructive" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DestructiveButtonLight}, Dark={StaticResource DestructiveButtonDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DestructiveForegroundLight}, Dark={StaticResource DestructiveForegroundDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DestructiveHoverLight}, Dark={StaticResource DestructiveHoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DestructiveHoverLight}, Dark={StaticResource DestructiveHoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonIcon" TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="{OnIdiom Phone=44, Default=36}" />
    </Style>

    <Style x:Key="ButtonIconOutline" TargetType="Button" BasedOn="{StaticResource ButtonOutline}">
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="{OnIdiom Phone=44, Default=36}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="{OnIdiom Phone='16', Default='24'}" />
    </Style>

    <Style x:Key="CardFlush" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="FormSurfacePlain" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="IconTileRiskUp" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RiskHighSurfaceLight}, Dark={StaticResource RiskHighSurfaceDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <Style x:Key="IconTileRiskDown" TargetType="Border" BasedOn="{StaticResource IconTileRiskUp}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RiskLowSurfaceLight}, Dark={StaticResource RiskLowSurfaceDark}}" />
    </Style>

    <Style x:Key="SidebarItem" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SidebarAccentLight}, Dark={StaticResource SidebarAccentDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SidebarAccentLight}, Dark={StaticResource SidebarAccentDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="AlertDestructive" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RiskHighSurfaceLight}, Dark={StaticResource RiskHighSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource RiskHighBorderLight}, Dark={StaticResource RiskHighBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="Alert" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
    </Style>

    <Style x:Key="Separator" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
    </Style>

    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
    </Style>

    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Ellipse" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style x:Key="BrandMark" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
    </Style>

    <Style x:Key="BrandMarkIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryForegroundLight}, Dark={StaticResource PrimaryForegroundDark}}" />
    </Style>

    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="BadgeTextBase" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource TextXs}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="BadgeIconBase" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Badge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style x:Key="BadgeText" TargetType="Label" BasedOn="{StaticResource BadgeTextBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryForegroundLight}, Dark={StaticResource PrimaryForegroundDark}}" />
    </Style>

    <Style x:Key="BadgeSecondary" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style x:Key="BadgeSecondaryText" TargetType="Label" BasedOn="{StaticResource BadgeTextBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryForegroundLight}, Dark={StaticResource SecondaryForegroundDark}}" />
    </Style>

    <Style x:Key="BadgeOutline" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource InputDark}}" />
    </Style>
    <Style x:Key="BadgeOutlineText" TargetType="Label" BasedOn="{StaticResource BadgeTextBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
    </Style>
    <Style x:Key="BadgeOutlineIcon" TargetType="Label" BasedOn="{StaticResource BadgeIconBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedForegroundLight}, Dark={StaticResource MutedForegroundDark}}" />
    </Style>

    <Style x:Key="BadgeRiskLow" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RiskLowSurfaceLight}, Dark={StaticResource RiskLowSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource RiskLowBorderLight}, Dark={StaticResource RiskLowBorderDark}}" />
    </Style>
    <Style x:Key="BadgeRiskLowText" TargetType="Label" BasedOn="{StaticResource BadgeTextBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskLowTextLight}, Dark={StaticResource RiskLowTextDark}}" />
    </Style>
    <Style x:Key="BadgeRiskLowIcon" TargetType="Label" BasedOn="{StaticResource BadgeIconBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskLowTextLight}, Dark={StaticResource RiskLowTextDark}}" />
    </Style>

    <Style x:Key="BadgeRiskMedium" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RiskMediumSurfaceLight}, Dark={StaticResource RiskMediumSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource RiskMediumBorderLight}, Dark={StaticResource RiskMediumBorderDark}}" />
    </Style>
    <Style x:Key="BadgeRiskMediumText" TargetType="Label" BasedOn="{StaticResource BadgeTextBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskMediumTextLight}, Dark={StaticResource RiskMediumTextDark}}" />
    </Style>
    <Style x:Key="BadgeRiskMediumIcon" TargetType="Label" BasedOn="{StaticResource BadgeIconBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskMediumTextLight}, Dark={StaticResource RiskMediumTextDark}}" />
    </Style>

    <Style x:Key="BadgeRiskHigh" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RiskHighSurfaceLight}, Dark={StaticResource RiskHighSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource RiskHighBorderLight}, Dark={StaticResource RiskHighBorderDark}}" />
    </Style>
    <Style x:Key="BadgeRiskHighText" TargetType="Label" BasedOn="{StaticResource BadgeTextBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskHighTextLight}, Dark={StaticResource RiskHighTextDark}}" />
    </Style>
    <Style x:Key="BadgeRiskHighIcon" TargetType="Label" BasedOn="{StaticResource BadgeIconBase}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskHighTextLight}, Dark={StaticResource RiskHighTextDark}}" />
    </Style>

    <Style x:Key="TextRiskUp" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RiskHighTextLight}, Dark={StaticResource RiskHighTextDark}}" />
    </Style>
    <Style x:Key="TextRiskDown" TargetType="Label">
