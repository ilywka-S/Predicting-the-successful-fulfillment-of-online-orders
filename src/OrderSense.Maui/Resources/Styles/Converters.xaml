<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:OrderSense.Maui.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <controls:PercentConverter x:Key="Percent" />

    <controls:MoneyConverter x:Key="Money" />

    <controls:KilometersConverter x:Key="Kilometers" />

    <controls:WeightConverter x:Key="Weight" />

    <controls:ShortIdConverter x:Key="ShortId" />

    <controls:OrderStatusConverter x:Key="OrderStatus" />

    <controls:PaymentTypeConverter x:Key="PaymentType" />

    <controls:CategoryConverter x:Key="Category" />

    <controls:RoleConverter x:Key="Role" />

    <toolkit:InvertedBoolConverter x:Key="Not" />
    <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
    <toolkit:IsNotNullConverter x:Key="NotNull" />
    <toolkit:IsNullConverter x:Key="IsNull" />

</ResourceDictionary>
