<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderSense.Maui.Views.MainPage"
             Title="Головна">
    
    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">
        <Label Text="{Binding Greeting}" FontSize="24" HorizontalOptions="Center" />
        <Button Text="Перейти до деталей" Command="{Binding GoToDetailsCommand}" HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>