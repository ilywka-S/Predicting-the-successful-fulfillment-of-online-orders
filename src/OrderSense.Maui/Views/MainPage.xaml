<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderSense.Maui.Views.MainPage"
             xmlns:viewmodels="clr-namespace:OrderSense.Maui.ViewModels"
             x:DataType="viewmodels:MainViewModel">
    
    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
        
        <Label Text="Sign In" FontSize="24" HorizontalOptions="Center" />

        <Entry Placeholder="Enter email" 
               Text="{Binding Email}" 
               Keyboard="Email" 
               ClearButtonVisibility="WhileEditing" />
        <Entry Placeholder="Enter password" 
               Text="{Binding Password}" 
               IsPassword="True" 
               ClearButtonVisibility="WhileEditing" />

        <Button Text="Login Test Auth" 
                Command="{Binding TestAuthCommand}" 
                HorizontalOptions="Center" 
                Margin="0,20,0,0" />
        
    </VerticalStackLayout>
</ContentPage>