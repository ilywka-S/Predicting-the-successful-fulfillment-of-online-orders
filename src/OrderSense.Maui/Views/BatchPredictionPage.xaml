<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OrderSense.Client.Core.ViewModels;assembly=OrderSense.Client.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="OrderSense.Maui.Views.BatchPredictionPage"
             Title="Пакетний прогноз">

    <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">
        <Button Text="Вибрати CSV" Command="{Binding SelectCsvCommand}" IsEnabled="{Binding IsProcessing, Converter={toolkit:InvertedBoolConverter}}" />
        <Label Text="{Binding SelectedFileName}" />

        <Button Text="Почати прогноз" Command="{Binding StartBatchJobCommand}" IsEnabled="{Binding IsProcessing, Converter={toolkit:InvertedBoolConverter}}" />

        <Label Text="{Binding StatusMessage}" />
        <ProgressBar Progress="{Binding Progress}" />

        <Button Text="Завантажити результат" Command="{Binding DownloadResultCommand}" IsVisible="{Binding IsFinished}" />

    </VerticalStackLayout>
</ContentPage>