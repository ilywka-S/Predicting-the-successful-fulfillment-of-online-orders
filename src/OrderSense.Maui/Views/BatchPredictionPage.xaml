<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:OrderSense.Client.Core;assembly=OrderSense.Client.Core"
             xmlns:vm="clr-namespace:OrderSense.Client.Core.ViewModels;assembly=OrderSense.Client.Core"
             xmlns:controls="clr-namespace:OrderSense.Maui.Controls"
             x:Class="OrderSense.Maui.Views.BatchPredictionPage"
             x:DataType="vm:BatchPredictionViewModel"
             Title="Пакетний прогноз">

    <ContentPage.Resources>

        <DataTemplate x:Key="RowErrorTemplate" x:DataType="vm:BatchRowError">
            <Grid ColumnDefinitions="88,*" ColumnSpacing="12" Padding="0,6">
                <Label Style="{StaticResource TextMedium}" Text="{Binding Location}" />
                <Label Grid.Column="1" Style="{StaticResource TextError}" Text="{Binding Message}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResultRowTemplate" x:DataType="api:BatchResultDto">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="{OnIdiom Phone='48,*,Auto', Default='80,100,160,*'}"
                      ColumnSpacing="16"
                      Padding="{OnIdiom Phone='0,10', Default='16,10'}">
                    <Label Style="{StaticResource TextMuted}"
                           VerticalOptions="Center"
                           Text="{Binding RowNo, StringFormat='#{0}'}" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center"
                                         IsVisible="{OnIdiom Phone=True, Default=False}">
                        <Label Style="{StaticResource TextMedium}"
                               Text="{Binding Probability, Converter={StaticResource Percent}, StringFormat='успіх {0}'}" />
                        <Label Style="{StaticResource TextSmall}"
                               LineBreakMode="TailTruncation"
                               Text="{Binding Factors, Converter={StaticResource TopFactor}}" />
                    </VerticalStackLayout>
                    <controls:RiskBadge Grid.Column="2"
                                        Compact="True"
                                        IsVisible="{OnIdiom Phone=True, Default=False}"
                                        Level="{Binding RiskLevel}" />

                    <Label Grid.Column="1"
                           VerticalOptions="Center"
                           IsVisible="{OnIdiom Phone=False, Default=True}"
                           Text="{Binding Probability, Converter={StaticResource Percent}}" />
                    <controls:RiskBadge Grid.Column="2"
                                        IsVisible="{OnIdiom Phone=False, Default=True}"
                                        Level="{Binding RiskLevel}" />
                    <Label Grid.Column="3"
                           Style="{StaticResource TextMuted}"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"
                           IsVisible="{OnIdiom Phone=False, Default=True}"
                           Text="{Binding Factors, Converter={StaticResource TopFactor}}" />
                </Grid>
                <BoxView Style="{StaticResource Separator}" />
            </VerticalStackLayout>
        </DataTemplate>

    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                            <Label Style="{StaticResource Icon}"
                                   HorizontalOptions="Center"
                                   Text="{x:Static controls:Icons.FileSpreadsheet}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Style="{StaticResource TextMedium}" Text="{Binding SelectedFileName}" />
                            <Label Style="{StaticResource TextSmall}" Text="CSV з колонками як у шаблоні, до 1 ГБ" />
                        </VerticalStackLayout>
                    </Grid>

                    <FlexLayout Wrap="Wrap" AlignItems="Center">
                        <Button Style="{StaticResource ButtonOutline}"
                                Margin="0,0,8,8"
                                Text="Обрати файл"
                                Command="{Binding SelectCsvCommand}" />
                        <Button Style="{StaticResource ButtonGhost}"
                                Margin="0,0,8,8"
                                Text="Шаблон CSV"
                                Command="{Binding DownloadTemplateCommand}" />
                        <Button Margin="0,0,8,8"
                                Text="Почати прогноз"
                                Command="{Binding StartBatchJobCommand}" />
                    </FlexLayout>

                    <BoxView Style="{StaticResource Separator}" />

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Style="{StaticResource TextMuted}"
                                   VerticalOptions="Center"
                                   Text="{Binding StatusMessage}" />
                            <ActivityIndicator Grid.Column="1"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               IsRunning="{Binding IsProcessing}"
                                               IsVisible="{Binding IsProcessing}" />
                        </Grid>
                        <controls:Meter Value="{Binding Progress}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Alert}" IsVisible="{Binding HasJobMessage}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icon}"
                                   VerticalOptions="Start"
                                   Text="{x:Static controls:Icons.Info}" />
                            <Label Grid.Column="1" Text="{Binding JobMessage}" />
                        </Grid>
                    </Border>

                    <Label Style="{StaticResource TextError}"
                           IsVisible="{Binding HasResultsError}"
                           Text="{Binding ResultsError}" />

                    <Button HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}"
                            Text="Завантажити результат CSV"
                            IsVisible="{Binding IsSuccess}"
                            Command="{Binding DownloadResultCommand}" />

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasRowErrors}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Style="{StaticResource IconError}"
                               VerticalOptions="Center"
                               Text="{x:Static controls:Icons.CircleAlert}" />
                        <Label Grid.Column="1" Style="{StaticResource TextH3}" Text="Помилки у файлі" />
                    </Grid>
                    <Label Style="{StaticResource TextSmall}" Text="Виправте ці рядки й завантажте файл ще раз." />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RowErrors}"
                                         BindableLayout.ItemTemplate="{StaticResource RowErrorTemplate}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{OnIdiom Phone={StaticResource Card}, Default={StaticResource CardFlush}}"
                    IsVisible="{Binding HasResults}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="{OnIdiom Phone='0,0,0,8', Default='16,16,16,8'}">
                        <Label Style="{StaticResource TextH3}" Text="Результати" />
                        <Label Grid.Column="1"
                               Style="{StaticResource TextSmall}"
                               VerticalOptions="Center"
                               Text="{Binding ResultsTotal, Converter={StaticResource Count}, ConverterParameter='рядок|рядки|рядків'}" />
                    </Grid>

                    <Grid Style="{StaticResource TableHeader}"
                          IsVisible="{OnIdiom Phone=False, Default=True}"
                          ColumnDefinitions="80,100,160,*">
                        <Label Style="{StaticResource TextTableHeader}" Text="Рядок" />
                        <Label Grid.Column="1" Style="{StaticResource TextTableHeader}" Text="Успіх" />
                        <Label Grid.Column="2" Style="{StaticResource TextTableHeader}" Text="Ризик" />
                        <Label Grid.Column="3" Style="{StaticResource TextTableHeader}" Text="Головний чинник" />
                    </Grid>
                    <BoxView Style="{StaticResource Separator}" IsVisible="{OnIdiom Phone=False, Default=True}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}"
                                         BindableLayout.ItemTemplate="{StaticResource ResultRowTemplate}" />

                    <Grid Padding="16" MinimumHeightRequest="64">
                        <ActivityIndicator HorizontalOptions="Center"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           IsRunning="{Binding IsLoadingResults}"
                                           IsVisible="{Binding IsLoadingResults}" />
                        <Button Style="{StaticResource ButtonOutline}"
                                HorizontalOptions="Center"
                                Text="Показати ще"
                                IsVisible="{Binding HasMoreResults}"
                                Command="{Binding LoadMoreResultsCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
