<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OrderSense.Client.Core.ViewModels;assembly=OrderSense.Client.Core"
             x:Class="OrderSense.Maui.Views.BatchPredictionPage"
             Title="Пакетний прогноз">

    <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">
        
        <Button Text="Обрати CSV файл" 
                Command="{Binding PickFileCommand}" />
        
        <Label Text="{Binding ErrorMessage}" 
               TextColor="Red" 
               HorizontalOptions="Center" />

        <Button Text="Почати обробку" 
                Command="{Binding UploadAndStartJobCommand}" />

        <VerticalStackLayout IsVisible="{Binding IsProcessing}" Spacing="5">
            <Label Text="Обробка даних..." HorizontalOptions="Center" TextColor="Gray"/>
            <ProgressBar Progress="{Binding Progress}" HeightRequest="10" />
        </VerticalStackLayout>

        <Button Text="Завантажити результат" 
                Command="{Binding DownloadResultsCommand}" 
                Style="{StaticResource PrimaryButton}" />

    </VerticalStackLayout>
</ContentPage>