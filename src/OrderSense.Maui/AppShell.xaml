<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OrderSense.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OrderSense.Maui.Views"
    FlyoutBehavior="{OnIdiom Phone=Disabled, Default=Flyout}">

    <TabBar>
        <Tab Title="Головна" Icon="dotnet_bot.png">
            <ShellContent Route="MainPage" ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>
        <Tab Title="Профіль" Icon="dotnet_bot.png">
            <ShellContent Route="ProfilePage" ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>
    </TabBar>

</Shell>