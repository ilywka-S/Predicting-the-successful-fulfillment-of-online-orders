<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OrderSense.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OrderSense.Maui.Views"
    xmlns:controls="clr-namespace:OrderSense.Maui.Controls"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent 
        ContentTemplate="{DataTemplate views:LoadingPage}" 
        Route="LoadingPage"/>

    <ShellContent 
        Route="LoginPage" 
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar>
        <Tab Title="Замовлення">
            <Tab.Icon>
                <FontImageSource FontFamily="Lucide"
                                 Glyph="{x:Static controls:Icons.Package}"
                                 Color="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
            </Tab.Icon>
            <ShellContent Route="OrdersPage" ContentTemplate="{DataTemplate views:OrdersPage}" />
        </Tab>
        <Tab>
            <ShellContent Title="Dashboard"
                          Icon="icon_dashboard.png"
                          ContentTemplate="{DataTemplate views:DashboardPage}"
                          Route="DashboardPage" />
        </Tab>
        <Tab Title="Головна" Icon="dotnet_bot.png">
            <ShellContent Route="MainPage" ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>

        <Tab Title="Пакетний прогноз" IsVisible="{Binding IsBatchPredictionVisible}">
            <ShellContent 
                ContentTemplate="{DataTemplate views:BatchPredictionPage}" />
        </Tab>
    </TabBar>

</Shell>